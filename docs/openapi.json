{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Integração Duotalk–Syonet",
    "description": "API de integração de leads do Duotalk com o Syonet CRM via HTTP",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "consumerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token que autoriza o sistema consumidor a usar a API"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/leads": {
      "post": {
        "tags": ["Leads"],
        "description": "Recebe os dados do lead do Duotalk e processa sincronamente por padrão. Para o modo assíncrono, habilite a fila e use POST /leads?sync=false",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["credentials", "target", "data"],
                "properties": {
                  "dryRun": {
                    "type": "boolean",
                    "description": "Controle de execução; true valida o fluxo sem executar POST ou PATCH no Syonet"
                  },
                  "daysToUpdateOpenEvent": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Quando maior que zero, reutiliza a oportunidade aberta mais recente do mesmo cliente, empresa, grupo e tipo dentro desta quantidade de dias e adiciona a nova observação como comentário"
                  },
                  "credentials": {
                    "type": "object",
                    "required": ["url", "username", "password"],
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "URL HTTPS do Syonet"
                      },
                      "username": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Compartilha com a senha o limite de tamanho do payload RSA"
                      },
                      "password": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "writeOnly": true,
                        "description": "Compartilha com o usuário o limite de tamanho do payload RSA"
                      }
                    }
                  },
                  "target": {
                    "type": "object",
                    "required": ["companyId"],
                    "additionalProperties": false,
                    "properties": { "companyId": { "type": "integer", "minimum": 1 } }
                  },
                  "data": {
                    "type": "object",
                    "required": ["nome", "telefone"],
                    "additionalProperties": true,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
                      },
                      "idConversa": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
                        "description": "Identidade idempotente da oportunidade; obrigatória quando dryRun não é true"
                      },
                      "origem": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "canal": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "qualificacaoLead": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "intermediario": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "operador": { "type": "string", "maxLength": 150 },
                      "nome": { "type": "string", "minLength": 1, "maxLength": 150 },
                      "telefone": { "type": "string", "minLength": 10, "maxLength": 30 },
                      "email": { "type": "string", "format": "email", "maxLength": 254 },
                      "mensagem": { "type": "string", "maxLength": 10000 },
                      "firstMessage": { "type": "string", "maxLength": 10000 },
                      "messageHistory": { "type": "string", "maxLength": 50000 },
                      "url_duotalk": { "type": "string", "maxLength": 2048 },
                      "intencao": { "type": "string", "maxLength": 200 }
                    }
                  }
                }
              },
              "example": {
                "credentials": {
                  "url": "https://seu-tenant.syonet.com",
                  "username": "usuario-tecnico",
                  "password": "senha"
                },
                "target": { "companyId": 25 },
                "dryRun": true,
                "daysToUpdateOpenEvent": 30,
                "data": {
                  "id": "lead-a1b2c3",
                  "idConversa": "conversa-a1b2c3",
                  "origem": "Outbound",
                  "canal": "WhatsApp 360",
                  "qualificacaoLead": "Lead",
                  "intermediario": "Duotalk",
                  "operador": "Operador Exemplo",
                  "nome": "Teste Duotalk a1b2c3",
                  "telefone": "5561999998888",
                  "email": "teste.duotalk.a1b2c3@example.com",
                  "mensagem": "Mensagem: Conversa criada manualmente",
                  "firstMessage": "Olá, gostaria de conhecer os veículos disponíveis.",
                  "messageHistory": "(20/08/2026, 10:00:00) Teste Duotalk a1b2c3: Olá, gostaria de conhecer os veículos disponíveis.",
                  "url_duotalk": "https://app.duotalk.io/apps/inbox/start-conversation?name=Teste%20Duotalk%20a1b2c3&phone=5561999998888",
                  "intencao": "DVNU - Veículos Novos"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [{ "consumerToken": [] }],
        "responses": {
          "200": {
            "description": "Lead processado; resultado disponível",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Lead processado; resultado disponível",
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["success", "message", "jobId", "status"],
                      "properties": {
                        "success": { "type": "boolean" },
                        "message": { "type": "string" },
                        "jobId": { "type": "string" },
                        "status": {
                          "type": "string",
                          "enum": ["pending", "processing", "completed", "failed"]
                        },
                        "duplicate": { "type": "boolean" },
                        "errorCode": { "type": "string" },
                        "result": {
                          "type": "object",
                          "required": [
                            "clientCreated",
                            "clientUpdated",
                            "clientId",
                            "companyId",
                            "dryRun",
                            "eventCreated",
                            "eventId",
                            "mapping"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "clientCreated": { "type": "boolean" },
                            "clientUpdated": { "type": "boolean" },
                            "clientId": { "type": ["null", "number"] },
                            "companyId": { "type": "integer" },
                            "dryRun": { "type": "boolean" },
                            "eventCreated": { "type": "boolean" },
                            "eventId": { "type": ["null", "number"] },
                            "mapping": {
                              "type": "object",
                              "required": ["contactForm", "eventGroupId", "eventTypeId", "media"],
                              "properties": {
                                "contactForm": { "type": "string" },
                                "eventGroupId": { "type": "string" },
                                "eventTypeId": { "type": "string" },
                                "media": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["success", "message", "status", "result"],
                      "properties": {
                        "success": { "type": "boolean", "enum": [true] },
                        "message": { "type": "string" },
                        "status": { "type": "string", "enum": ["completed"] },
                        "result": {
                          "type": "object",
                          "required": [
                            "clientCreated",
                            "clientUpdated",
                            "clientId",
                            "companyId",
                            "dryRun",
                            "eventCreated",
                            "eventId",
                            "mapping"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "clientCreated": { "type": "boolean" },
                            "clientUpdated": { "type": "boolean" },
                            "clientId": { "type": ["null", "number"] },
                            "companyId": { "type": "integer" },
                            "dryRun": { "type": "boolean" },
                            "eventCreated": { "type": "boolean" },
                            "eventId": { "type": ["null", "number"] },
                            "mapping": {
                              "type": "object",
                              "required": ["contactForm", "eventGroupId", "eventTypeId", "media"],
                              "properties": {
                                "contactForm": { "type": "string" },
                                "eventGroupId": { "type": "string" },
                                "eventTypeId": { "type": "string" },
                                "media": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Lead aceito para processamento em segundo plano",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Lead aceito para processamento em segundo plano",
                  "type": "object",
                  "required": ["success", "message", "jobId", "status"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "processing", "completed", "failed"]
                    },
                    "duplicate": { "type": "boolean" },
                    "errorCode": { "type": "string" },
                    "result": {
                      "type": "object",
                      "required": [
                        "clientCreated",
                        "clientUpdated",
                        "clientId",
                        "companyId",
                        "dryRun",
                        "eventCreated",
                        "eventId",
                        "mapping"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "clientCreated": { "type": "boolean" },
                        "clientUpdated": { "type": "boolean" },
                        "clientId": { "type": ["null", "number"] },
                        "companyId": { "type": "integer" },
                        "dryRun": { "type": "boolean" },
                        "eventCreated": { "type": "boolean" },
                        "eventId": { "type": ["null", "number"] },
                        "mapping": {
                          "type": "object",
                          "required": ["contactForm", "eventGroupId", "eventTypeId", "media"],
                          "properties": {
                            "contactForm": { "type": "string" },
                            "eventGroupId": { "type": "string" },
                            "eventTypeId": { "type": "string" },
                            "media": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload ou requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Payload ou requisição inválida",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "errors": {},
                    "errorCode": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token de acesso ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Token de acesso ausente ou inválido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Job duplicado com falha que exige conciliação",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Job duplicado com falha que exige conciliação",
                  "type": "object",
                  "required": ["success", "message", "jobId", "status"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "processing", "completed", "failed"]
                    },
                    "duplicate": { "type": "boolean" },
                    "errorCode": { "type": "string" },
                    "result": {
                      "type": "object",
                      "required": [
                        "clientCreated",
                        "clientUpdated",
                        "clientId",
                        "companyId",
                        "dryRun",
                        "eventCreated",
                        "eventId",
                        "mapping"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "clientCreated": { "type": "boolean" },
                        "clientUpdated": { "type": "boolean" },
                        "clientId": { "type": ["null", "number"] },
                        "companyId": { "type": "integer" },
                        "dryRun": { "type": "boolean" },
                        "eventCreated": { "type": "boolean" },
                        "eventId": { "type": ["null", "number"] },
                        "mapping": {
                          "type": "object",
                          "required": ["contactForm", "eventGroupId", "eventTypeId", "media"],
                          "properties": {
                            "contactForm": { "type": "string" },
                            "eventGroupId": { "type": "string" },
                            "eventTypeId": { "type": "string" },
                            "media": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unidade ou mapeamento incompatível",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Unidade ou mapeamento incompatível",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "errors": {},
                    "errorCode": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Limite de requisições excedido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao processar a requisição",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Erro interno ao processar a requisição",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "errors": {},
                    "errorCode": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Modo assíncrono indisponível, processador ausente ou fila temporariamente sem capacidade",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Modo assíncrono indisponível, processador ausente ou fila temporariamente sem capacidade",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "504": {
            "description": "Prazo síncrono esgotado; job não cancelado e ainda pendente ou em processamento",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Prazo síncrono esgotado; job não cancelado e ainda pendente ou em processamento",
                  "type": "object",
                  "required": ["success", "message", "jobId", "status"],
                  "properties": {
                    "success": { "type": "boolean", "enum": [false] },
                    "message": { "type": "string" },
                    "jobId": { "type": "string" },
                    "status": { "type": "string", "enum": ["pending", "processing"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Status"],
        "description": "Healthcheck básico da aplicação",
        "responses": {
          "200": {
            "description": "Serviço operacional",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Serviço operacional",
                  "type": "object",
                  "required": ["status", "timestamp", "uptime"],
                  "properties": {
                    "status": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "uptime": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/queue/status": {
      "get": {
        "tags": ["Fila"],
        "description": "Estatísticas da fila de processamento de leads",
        "security": [{ "consumerToken": [] }],
        "responses": {
          "200": {
            "description": "Estatísticas da fila obtidas com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Estatísticas da fila obtidas com sucesso",
                  "type": "object",
                  "required": ["success", "stats"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "stats": {
                      "type": "object",
                      "properties": {
                        "pending": { "type": "integer" },
                        "processing": { "type": "integer" },
                        "completed": { "type": "integer" },
                        "failed": { "type": "integer" },
                        "total": { "type": "integer" },
                        "driver": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token de acesso ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Token de acesso ausente ou inválido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Limite de requisições excedido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/queue/jobs/{id}": {
      "get": {
        "tags": ["Fila"],
        "description": "Consulta o status de um job específico por ID",
        "parameters": [
          { "schema": { "type": "string" }, "in": "path", "name": "id", "required": true }
        ],
        "security": [{ "consumerToken": [] }],
        "responses": {
          "200": {
            "description": "Status do job obtido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Status do job obtido com sucesso",
                  "type": "object",
                  "required": ["success", "job"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "job": {
                      "type": "object",
                      "required": [
                        "id",
                        "status",
                        "attempts",
                        "maxAttempts",
                        "createdAt",
                        "updatedAt"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string" },
                        "status": {
                          "type": "string",
                          "enum": ["pending", "processing", "completed", "failed"]
                        },
                        "attempts": { "type": "integer" },
                        "maxAttempts": { "type": "integer" },
                        "errorCode": { "type": "string" },
                        "result": {
                          "type": "object",
                          "required": [
                            "clientCreated",
                            "clientUpdated",
                            "clientId",
                            "companyId",
                            "dryRun",
                            "eventCreated",
                            "eventId",
                            "mapping"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "clientCreated": { "type": "boolean" },
                            "clientUpdated": { "type": "boolean" },
                            "clientId": { "type": ["null", "number"] },
                            "companyId": { "type": "integer" },
                            "dryRun": { "type": "boolean" },
                            "eventCreated": { "type": "boolean" },
                            "eventId": { "type": ["null", "number"] },
                            "mapping": {
                              "type": "object",
                              "required": ["contactForm", "eventGroupId", "eventTypeId", "media"],
                              "properties": {
                                "contactForm": { "type": "string" },
                                "eventGroupId": { "type": "string" },
                                "eventTypeId": { "type": "string" },
                                "media": { "type": "string" }
                              }
                            }
                          }
                        },
                        "createdAt": { "type": "string", "format": "date-time" },
                        "updatedAt": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token de acesso ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Token de acesso ausente ou inválido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Job não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Job não encontrado",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Limite de requisições excedido",
                  "type": "object",
                  "required": ["success", "message"],
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": { "default": "http://localhost:3000", "description": "Endereço base da API" }
      }
    }
  ]
}
