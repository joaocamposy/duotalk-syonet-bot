# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TZ=America/Sao_Paulo

# Autenticação dos consumidores e criptografia das credenciais na fila
MICROSERVICE_API_TOKEN=gere-um-token-aleatorio-forte
# Gere com: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=cole-a-chave-base64-de-32-bytes

# Driver de Fila: 'memory' | 'file'
QUEUE_DRIVER=file
QUEUE_FILE_PATH=./data/queue.json
QUEUE_CONCURRENCY=1
QUEUE_RETRY_BASE_DELAY_MS=1000
QUEUE_MAX_JOBS=1000
DEDUP_WINDOW_MINUTES=5
JOB_RETENTION_DAYS=7
SYNC_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=30000
SYONET_HTTP_TIMEOUT_MS=15000

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Logs estruturados enviados para stdout
LOG_LEVEL=info

# Usada somente por `npm run test:lead`; mantenha false exceto na gravação controlada
ALLOW_WRITE_TEST=false
