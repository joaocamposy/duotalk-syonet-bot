# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Credenciais e URL do Syonet CRM SaaS
SYONET_URL=https://syonet.exemplo.com.br
SYONET_USER=usuario_teste
SYONET_PASS=senha_teste

# Driver de Fila: 'memory' | 'file' | 'redis'
QUEUE_DRIVER=file
QUEUE_FILE_PATH=./data/queue.json
QUEUE_CONCURRENCY=1
DEDUP_WINDOW_MINUTES=5

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Automação Playwright
HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logs e Auto-Purge
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_DIR=./logs
