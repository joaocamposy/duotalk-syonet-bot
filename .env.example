# Porta TCP exposta pelo Fastify (padrão: 3000)
PORT=3000
# Interface de escuta; 0.0.0.0 é necessário dentro de containers
HOST=0.0.0.0
# development habilita Swagger; production exige tokens fortes e desabilita /docs
NODE_ENV=development
# Bearer compartilhado com os consumidores da API; mínimo de 32 caracteres em produção
API_TOKEN=gere-um-token-aleatorio-forte
# Chave AES-256-GCM usada somente quando a fila está habilitada
# Com QUEUE_ENABLED=true, deve conter 32 bytes em Base64. Gere com: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Processamento síncrono é o padrão; true habilita também o modo assíncrono com sync=false
QUEUE_ENABLED=false
# Driver quando habilitado: file persiste reinícios; memory perde jobs ao encerrar
QUEUE_DRIVER=file
# Caminho usado somente pelo driver file; o processo precisa ter permissão de escrita
QUEUE_FILE_PATH=./data/queue.json
# Quantidade máxima de jobs processados simultaneamente (1 a 10)
QUEUE_CONCURRENCY=1
# Base, em milissegundos, do retry exponencial para falhas seguramente repetíveis
QUEUE_RETRY_BASE_DELAY_MS=1000
# Limite de jobs mantidos; ao lotar sem job terminal removível, POST /leads responde 503
QUEUE_MAX_JOBS=1000
# Janela, em minutos, da deduplicação quando não há idConversa nem id e o telefone é usado
DEDUP_WINDOW_MINUTES=5
# Retenção, em dias, de jobs terminais e deduplicação baseada em idConversa ou id
JOB_RETENTION_DAYS=7
# Com a fila habilitada, prazo de sync=true antes do 504; o job não é cancelado
SYNC_TIMEOUT_MS=60000
# Prazo máximo para concluir jobs ativos durante o encerramento gracioso
SHUTDOWN_TIMEOUT_MS=30000
# Timeout, em milissegundos, aplicado individualmente a cada chamada HTTP ao Syonet
SYONET_HTTP_TIMEOUT_MS=15000
# Tamanho máximo, em bytes, aceito em cada resposta JSON do Syonet (padrão: 2 MiB)
SYONET_HTTP_MAX_RESPONSE_BYTES=2097152
# Prazo total, em milissegundos, para autenticar e processar um lead no Syonet
SYONET_PROCESS_TIMEOUT_MS=60000

# Máximo de requisições por janela para o consumidor autorizado
RATE_LIMIT_MAX=100
# Janela aceita pelo @fastify/rate-limit, por exemplo: 1 minute, 30 seconds
RATE_LIMIT_TIME_WINDOW=1 minute

# Nível mínimo dos logs JSON enviados para stdout: trace, debug, info, warn, error ou fatal
LOG_LEVEL=info

# Proteção exclusiva de `npm run test:lead`; true permite gravação real naquele comando local
# Não altera o comportamento do endpoint HTTP. Mantenha false fora de um teste controlado
ALLOW_WRITE_TEST=false
